{
  "name": "sighthound-content-ops",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "next dev",
    "dev:full": "concurrently \"next dev\" \"npm run typecheck -- --watch\"",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:full": "next lint --no-cache",
    "typecheck": "tsc --noEmit",
    "check": "run-p lint typecheck",
    "check:full": "run-s lint:full typecheck build",
    "check:design-system": "node scripts/check-design-system-adherence.mjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:workflow": "jest --config jest.workflow.config.js --runInBand",
    "test:workflow:tooling": "node --test tests/debug/workflow-harness.test.mjs",
    "test:workflow:ui": "playwright test --config playwright.workflow.config.ts",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "test:visual:report": "playwright show-report",
    "prepare": "husky",
    "import:legacy": "node scripts/import-legacy-xlsx.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.99.1",
    "date-fns": "^3.6.0",
    "dotenv": "^16.4.5",
    "lucide-react": "^0.577.0",
    "next": "15.5.29",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@modelcontextprotocol/client": "^2.4.0",
    "@playwright/test": "^1.49.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@testing-library/jest-dom": "^6.1.4",
    "@testing-library/react": "^14.0.0",
    "@types/jest": "29.5.14",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "husky": "^9.1.7",
    "jest": "29.7.0",
    "jest-environment-node": "29.7.0",
    "lint-staged": "^16.3.3",
    "npm-run-all": "^4.1.5",
    "tailwindcss": "^4",
    "ts-prune": "^0.10.3",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.32",
    "brace-expansion@^1": "1.1.21",
    "minimatch@^9.0.0": "11.0.4",
    "minimatch@^10.2.2": "11.0.4",
    "glob": "14.0.3",
    "deepmerge": "4.1.1"
  }
}
